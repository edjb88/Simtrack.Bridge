<Window x:Class="Simtrack.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes · Simtrack Bridge"
        Height="520"
        Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#10141C"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B2330"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#39D98A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#91A0B5"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#253244"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#31415A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="AJUSTES" FontSize="26" FontWeight="Bold" Foreground="#39D98A"/>
            <TextBlock Text="Calibración y puesta a punto del tracking" FontSize="13" Foreground="#91A0B5"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="22">
            <StackPanel>
                <TextBlock Text="CALIBRACIÓN" FontSize="13" FontWeight="Bold" Foreground="#91A0B5"/>
                <TextBlock Text="Recorre los movimientos guiados para ajustar los ejes de la cabeza (yaw, pitch y roll). Al terminar, los ajustes se guardan solos."
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="#D7E0EA"
                           Margin="0,8,0,18"/>

                <Button x:Name="CalibrateButton" Content="INICIAR CALIBRACIÓN" Click="CalibrateButton_Click"/>

                <TextBlock x:Name="StatusText"
                           Margin="0,16,0,0"
                           FontSize="12"
                           Foreground="#91A0B5"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="CERRAR" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
